# Local dashboard only. Generate private values before configuring integrations.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# DJANGO_SECRET_KEY=replace-with-your-generated-private-value
# TOKEN_PEPPER=replace-with-a-different-generated-private-value
# HUNTFLOW_CREDENTIAL_ENCRYPTION_KEY=replace-with-your-generated-base64-key
# Omit DATABASE_URL to use data/db.sqlite3 locally.
# DATABASE_URL=postgresql://your_user:your_password@127.0.0.1:5432/your_database
# REDIS_URL=redis://127.0.0.1:6379/0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
