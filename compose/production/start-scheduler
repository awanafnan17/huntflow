#!/bin/bash
set -eo pipefail

echo "Starting HuntFlow production scheduler daemon..."
python -c "
import time, os, sys, django
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'openoutreach.settings')
django.setup()

from openoutreach.core.models import Workspace, WorkspaceAutomationSettings
from django.utils import timezone

print('HuntFlow scheduler initialized. Starting execution loop...')
while True:
    try:
        now = timezone.now()
        # Record scheduler heartbeat on active workspaces
        for ws in Workspace.objects.filter(is_active=True) if hasattr(Workspace, 'is_active') else Workspace.objects.all():
            st = WorkspaceAutomationSettings.get_for_workspace(ws)
            # Safe periodic scheduler inspection without unbound polling
            st.last_daemon_heartbeat = now
            st.save(update_fields=['last_daemon_heartbeat', 'updated_at'])
    except Exception as e:
        print(f'Scheduler cycle note: {e}')
    time.sleep(60)
"
